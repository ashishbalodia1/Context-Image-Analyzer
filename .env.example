# City Guardian Dataset Credentials Configuration
# Copy this file to .env and fill in your keys:

# 1. Hugging Face S3 Bucket Credentials for fire_smoke_dataset_fasdd_cv-bucket
# (Obtain from your Hugging Face Settings -> Access Tokens or Storage/Buckets)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# 2. Roboflow Universe API Key for road-damage-iztzn (RDD2022)
# (Obtain free from https://app.roboflow.com/ -> Account Settings -> Roboflow API)
ROBOFLOW_API_KEY=
